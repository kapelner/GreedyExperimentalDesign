#!/bin/sh

BASE_DIR=$(cd "$(dirname "$0")" && pwd)

wgpu_cppflags=""
wgpu_libs=""

for arg in "$@"; do
	case "$arg" in
        --with-wgpu)
            with_wgpu=yes
            ;;
        --without-wgpu)
            with_wgpu=no
            ;;
	esac
done

if [ -z "$with_wgpu" ]; then
    with_wgpu=auto
fi

# WebGPU detection (preferring the one in ../lib/wgpu)
if [ "$with_wgpu" != "no" ]; then
    WGPU_DIR="../lib/wgpu"
    WGPU_H1="${WGPU_DIR}/include/webgpu/webgpu.h"
    WGPU_H2="${WGPU_DIR}/include/webgpu/wgpu.h"
    WGPU_DLL="${WGPU_DIR}/lib/wgpu_native.dll"
    WGPU_LIB="${WGPU_DIR}/lib/libwgpu_native.a"

    if [ -f "$WGPU_H1" ] && [ -f "$WGPU_H2" ] && [ -f "$WGPU_DLL" ] && [ -f "$WGPU_LIB" ]; then
        # Use relative path for R to normalize; R (Windows) will resolve this 
        # relative to the package directory where configure.win is running.
        WGPU_DIR_WIN=$(Rscript -e "cat(normalizePath('${WGPU_DIR}', winslash = '/', mustWork = FALSE))")
        wgpu_cppflags="-I\"${WGPU_DIR_WIN}/include\" -DGED_USE_WGPU"
        wgpu_libs="-L\"${WGPU_DIR_WIN}/lib\" -lwgpu_native -lws2_32 -luserenv -lntdll -lbcrypt -ld3d12 -ldxgi -ld3dcompiler -lsetupapi"
        echo "configure.win: wgpu-native found in $WGPU_DIR_WIN"
    else
        if [ "$with_wgpu" = "yes" ]; then
            echo "configure.win: error: --with-wgpu requested, but required files not found in ../lib/wgpu" >&2
            echo "  Looking for:" >&2
            echo "    - $WGPU_H1" >&2
            echo "    - $WGPU_H2" >&2
            echo "    - $WGPU_DLL" >&2
            echo "    - $WGPU_LIB" >&2
            exit 1
        fi
        echo "configure.win: wgpu-native not found or incomplete in ../lib/wgpu; falling back to CPU-only build."
        echo "  (Missing one or more of: webgpu.h, wgpu.h, wgpu_native.dll, libwgpu_native.a)"
    fi
fi

# Rcpp headers
RCPP_INC=`Rscript -e 'cat(system.file("include", package="Rcpp"))'`
FINAL_CPPFLAGS="$wgpu_cppflags -I\"$RCPP_INC\""
FINAL_LIBS="$wgpu_libs"

# Clean up any stale object files or DLLs from previous failed/different builds
# to prevent LTO version mismatch errors.
rm -f "${BASE_DIR}/src/"*.o "${BASE_DIR}/src/"*.dll

sed \
	-e "s|@GED_WIN_CPPFLAGS@|$FINAL_CPPFLAGS|g" \
	-e "s|@GED_WIN_LIBS@|$FINAL_LIBS|g" \
	"${BASE_DIR}/src/Makevars.win.in" > "${BASE_DIR}/src/Makevars.win"

exit 0
